#!/usr/bin/env bash
# blue-green release cutover with nginx
set -Eeuo pipefail
umask 027

readonly BASE="/var/lib/memphis-deploy"
readonly INCOMING="$BASE/incoming"
readonly RELEASES="$BASE/releases"
readonly CURRENT="$BASE/current"
readonly SLOTS="$BASE/slots"
readonly MAIN_SERVICE="memphis-lspd.service"
readonly SLOT_PREFIX="memphis-lspd-slot@"
readonly APP_USER="memphis"
readonly APP_GROUP="memphis"
readonly DOMAIN="suspect-famq.ru"
readonly UPSTREAM_DIR="/etc/nginx/conf.d"
readonly UPSTREAM_FILE="$UPSTREAM_DIR/memphis-lspd-upstream.conf"
readonly SLOT_TEMPLATE="/etc/systemd/system/memphis-lspd-slot@.service"
readonly ACTIVE_PORT_FILE="$BASE/active-port"
readonly PREVIOUS_PORT_FILE="$BASE/previous-port"
readonly PREVIOUS_RELEASE_FILE="$BASE/previous-release"
readonly PENDING_FILE="$BASE/pending-deployment"

log() { printf '[memphis-deploy] %s\n' "$*"; }
die() { printf '[memphis-deploy] ERROR: %s\n' "$*" >&2; exit 1; }

[[ "$EUID" -eq 0 ]] || die "must run as root through the restricted sudo rule"
for command_name in systemctl curl tar python3 flock install stat find sort runuser seq nginx readlink sed grep awk mktemp chown chmod mv ln rm sleep cp wc; do
  command -v "$command_name" >/dev/null 2>&1 || die "required utility missing: $command_name"
done

[[ -d "$INCOMING" ]] || die "incoming directory is missing"
id "$APP_USER" >/dev/null 2>&1 || die "application account '$APP_USER' is missing"
[[ -f "$SLOT_TEMPLATE" ]] || die "blue-green systemd slot template is missing"
[[ -f "$UPSTREAM_FILE" ]] || die "managed Nginx upstream configuration is missing"

DEPLOY_USER="$(stat -c '%U' "$INCOMING")"
[[ -n "$DEPLOY_USER" && "$DEPLOY_USER" != "root" ]] || die "incoming directory has no dedicated unprivileged owner"

log() { printf '[memphis-deploy] %s\n' "$*"; }

port_is_valid() {
  [[ "$1" == "3000" || "$1" == "3001" ]]
}

release_path_is_valid() {
  [[ "$1" == "/opt/memphis-lspd" || "$1" =~ ^/var/lib/memphis-deploy/releases/[0-9a-f]{40}$ ]]
}

slot_service() {
  printf '%s%s.service' "$SLOT_PREFIX" "$1"
}

health_check_port() {
  port_is_valid "$1" || return 1
  curl --fail --silent --show-error --max-time 4 "http://127.0.0.1:$1/start" -o /dev/null
}

wait_for_port_health() {
  local attempt
  for attempt in $(seq 1 30); do
    if health_check_port "$1" >/dev/null 2>&1; then return 0; fi
    sleep 2
  done
  return 1
}

site_health_check() {
  curl --insecure --resolve "$DOMAIN:443:127.0.0.1" --fail --silent --show-error --max-time 8 "https://$DOMAIN/start" -o /dev/null
}

wait_for_site_health() {
  local attempt
  for attempt in $(seq 1 20); do
    if site_health_check >/dev/null 2>&1; then return 0; fi
    sleep 2
  done
  return 1
}

read_upstream_port() {
  local matches
  matches="$(grep -Ec '^[[:space:]]*server 127\.0\.0\.1:300[01];[[:space:]]*$' "$UPSTREAM_FILE" || true)"
  [[ "$matches" == "1" ]] || die "Nginx upstream must contain exactly one managed localhost backend"
  sed -nE 's/^[[:space:]]*server 127\.0\.0\.1:(300[01]);[[:space:]]*$/\1/p' "$UPSTREAM_FILE"
}

write_root_file() {
  local path="$1" value="$2" temporary
  temporary="$(mktemp "$BASE/.state.XXXXXX")"
  printf '%s\n' "$value" > "$temporary"
  chown root:root "$temporary"
  chmod 0640 "$temporary"
  mv -f "$temporary" "$path"
}

restore_file_value() {
  if [[ "$2" == "-" ]]; then rm -f "$1"; else write_root_file "$1" "$2"; fi
}

atomic_set_symlink() {
  local link_path="$1" target="$2" temporary="$1.next.$$"
  rm -f "$temporary"
  ln -s "$target" "$temporary"
  mv -Tf "$temporary" "$link_path"
}

atomic_set_slot() {
  mkdir -p "$SLOTS"
  chown root:"$APP_GROUP" "$SLOTS"
  chmod 0750 "$SLOTS"
  atomic_set_symlink "$SLOTS/$1" "$2"
}

atomic_set_current() {
  atomic_set_symlink "$CURRENT" "$1"
}

write_upstream_config() {
  local port="$1" temporary
  port_is_valid "$port" || return 1
  temporary="$(mktemp "$UPSTREAM_DIR/.memphis-lspd-upstream.XXXXXX")"
  cat > "$temporary" <<EOF
upstream memphis_lspd_backend {
    server 127.0.0.1:$port;
}
EOF
  chown root:root "$temporary"
  chmod 0644 "$temporary"
  mv -f "$temporary" "$UPSTREAM_FILE"
}

switch_upstream_port() {
  local port="$1" backup
  port_is_valid "$port" || return 1
  backup="$(mktemp "$UPSTREAM_DIR/.memphis-lspd-backup.XXXXXX")"
  cp -p "$UPSTREAM_FILE" "$backup"
  write_upstream_config "$port" || { mv -f "$backup" "$UPSTREAM_FILE"; return 1; }

  if ! nginx -t; then
    mv -f "$backup" "$UPSTREAM_FILE"
    nginx -t >/dev/null 2>&1 || true
    return 1
  fi
  if ! systemctl reload nginx; then
    mv -f "$backup" "$UPSTREAM_FILE"
    nginx -t >/dev/null 2>&1 && systemctl reload nginx >/dev/null 2>&1 || true
    return 1
  fi
  if ! wait_for_site_health; then
    log "Nginx health check failed on port $port; restoring the previous upstream"
    mv -f "$backup" "$UPSTREAM_FILE"
    if nginx -t && systemctl reload nginx; then
      wait_for_site_health || log "CRITICAL: previous Nginx upstream did not recover"
    else
      log "CRITICAL: could not reload the previous Nginx upstream"
    fi
    return 1
  fi
  rm -f "$backup"
  log "Nginx now routes to 127.0.0.1:$port (graceful reload)"
}

wait_for_current_service() {
  local port="$1"
  if [[ -f "$ACTIVE_PORT_FILE" ]]; then
    systemctl is-active --quiet "$(slot_service "$port")" || return 1
  else
    systemctl is-active --quiet "$MAIN_SERVICE" || return 1
  fi
  wait_for_port_health "$port"
}

pending_load() {
  [[ -f "$PENDING_FILE" && ! -L "$PENDING_FILE" ]] || return 1
  [[ "$(wc -l < "$PENDING_FILE")" == "8" ]] || return 1
  P_SHA="$(sed -n '1p' "$PENDING_FILE")"
  P_NEW_PORT="$(sed -n '2p' "$PENDING_FILE")"
  P_OLD_PORT="$(sed -n '3p' "$PENDING_FILE")"
  P_OLD_RELEASE="$(sed -n '4p' "$PENDING_FILE")"
  P_HAD_ACTIVE="$(sed -n '5p' "$PENDING_FILE")"
  P_OLD_PREVIOUS_RELEASE="$(sed -n '6p' "$PENDING_FILE")"
  P_OLD_PREVIOUS_PORT="$(sed -n '7p' "$PENDING_FILE")"
  P_RELEASE_CREATED="$(sed -n '8p' "$PENDING_FILE")"
  [[ "$P_SHA" =~ ^[0-9a-f]{40}$ ]] || return 1
  port_is_valid "$P_NEW_PORT" && port_is_valid "$P_OLD_PORT" || return 1
  release_path_is_valid "$P_OLD_RELEASE" || return 1
  [[ "$P_HAD_ACTIVE" == "0" || "$P_HAD_ACTIVE" == "1" ]] || return 1
  [[ "$P_RELEASE_CREATED" == "0" || "$P_RELEASE_CREATED" == "1" ]] || return 1
  if [[ "$P_OLD_PREVIOUS_RELEASE" != "-" ]]; then release_path_is_valid "$P_OLD_PREVIOUS_RELEASE" || return 1; fi
  if [[ "$P_OLD_PREVIOUS_PORT" != "-" ]]; then port_is_valid "$P_OLD_PREVIOUS_PORT" || return 1; fi
  [[ "$P_NEW_PORT" != "$P_OLD_PORT" ]]
}

write_pending() {
  local temporary
  temporary="$(mktemp "$BASE/.pending.XXXXXX")"
  printf '%s\n' "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$8" > "$temporary"
  chown root:root "$temporary"
  chmod 0600 "$temporary"
  mv -f "$temporary" "$PENDING_FILE"
}

rollback_pending_internal() {
  pending_load || die "pending deployment state is missing or invalid"
  log "restoring the previous Nginx upstream on port $P_OLD_PORT"
  switch_upstream_port "$P_OLD_PORT" || die "could not restore the previous Nginx upstream"
  atomic_set_current "$P_OLD_RELEASE"
  if [[ "$P_HAD_ACTIVE" == "1" ]]; then
    write_root_file "$ACTIVE_PORT_FILE" "$P_OLD_PORT"
    systemctl enable "$(slot_service "$P_OLD_PORT")" >/dev/null 2>&1 || true
  else
    rm -f "$ACTIVE_PORT_FILE"
    systemctl enable "$MAIN_SERVICE" >/dev/null 2>&1 || true
  fi
  restore_file_value "$PREVIOUS_RELEASE_FILE" "$P_OLD_PREVIOUS_RELEASE"
  restore_file_value "$PREVIOUS_PORT_FILE" "$P_OLD_PREVIOUS_PORT"
  sleep 5
  systemctl stop "$(slot_service "$P_NEW_PORT")" >/dev/null 2>&1 || true
  systemctl disable "$(slot_service "$P_NEW_PORT")" >/dev/null 2>&1 || true
  if [[ -L "$SLOTS/$P_NEW_PORT" && "$(readlink -f "$SLOTS/$P_NEW_PORT")" == "$RELEASES/$P_SHA" ]]; then
    rm -f "$SLOTS/$P_NEW_PORT"
  fi
  rm -f "$INCOMING/$P_SHA.tar.gz"
  if [[ "$P_RELEASE_CREATED" == "1" ]]; then rm -rf "$RELEASES/$P_SHA"; fi
  rm -f "$PENDING_FILE"
  log "pending deployment rolled back; previous application is healthy"
}

PREPARING=0
RELEASE=""
STAGING=""
CANDIDATE_PORT=""
RELEASE_CREATED=0

cleanup_failed_prepare() {
  local code="$?"
  trap - EXIT
  if [[ "$PREPARING" == "1" && "$code" -ne 0 ]]; then
    log "preparation failed; restoring the previous route"
    if [[ -f "$PENDING_FILE" ]]; then
      rollback_pending_internal || log "CRITICAL: automatic restoration failed"
    elif [[ -n "$CANDIDATE_PORT" ]]; then
      systemctl stop "$(slot_service "$CANDIDATE_PORT")" >/dev/null 2>&1 || true
      systemctl disable "$(slot_service "$CANDIDATE_PORT")" >/dev/null 2>&1 || true
      if [[ -L "$SLOTS/$CANDIDATE_PORT" && -n "$RELEASE" && "$(readlink -f "$SLOTS/$CANDIDATE_PORT")" == "$RELEASE" ]]; then
        rm -f "$SLOTS/$CANDIDATE_PORT"
      fi
      if [[ "$RELEASE_CREATED" == "1" ]]; then rm -rf "$RELEASE"; fi
    fi
    if [[ -n "$STAGING" ]]; then rm -rf "$STAGING"; fi
  fi
  exit "$code"
}

prepare_deploy() {
  local sha="$1" active_port upstream_port old_release candidate_port
  local had_active old_previous_release old_previous_port
  local release_created=0

  [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || die "invalid commit SHA"
  [[ ! -e "$PENDING_FILE" ]] || die "another deployment is waiting for commit or rollback"
  [[ -L "$CURRENT" ]] || die "current release symlink is missing"
  old_release="$(readlink -f "$CURRENT")"
  release_path_is_valid "$old_release" || die "current release points outside the managed release directories"

  if [[ -f "$ACTIVE_PORT_FILE" ]]; then
    active_port="$(cat "$ACTIVE_PORT_FILE")"
    had_active=1
  else
    active_port="3000"
    had_active=0
  fi
  port_is_valid "$active_port" || die "active application port state is invalid"
  upstream_port="$(read_upstream_port)"
  [[ "$upstream_port" == "$active_port" ]] || die "Nginx upstream port and active-port state do not match"
  wait_for_current_service "$active_port" || die "the currently routed application is not healthy"
  site_health_check || die "the Nginx virtual host is not healthy before deployment"

  if [[ -f "$PREVIOUS_RELEASE_FILE" ]]; then
    old_previous_release="$(cat "$PREVIOUS_RELEASE_FILE")"
    release_path_is_valid "$old_previous_release" || die "previous release state is invalid"
  else
    old_previous_release="-"
  fi
  if [[ -f "$PREVIOUS_PORT_FILE" ]]; then
    old_previous_port="$(cat "$PREVIOUS_PORT_FILE")"
    port_is_valid "$old_previous_port" || die "previous port state is invalid"
  else
    old_previous_port="-"
  fi

  RELEASE="$RELEASES/$sha"
  STAGING="$RELEASES/.staging-$sha"
  CANDIDATE_PORT=""
  RELEASE_CREATED=0
  PREPARING=1
  trap cleanup_failed_prepare EXIT

  if [[ "$old_release" == "$RELEASE" ]]; then
    log "commit $sha is already the active release; no traffic switch is needed"
    PREPARING=0
    trap - EXIT
    rm -f "$INCOMING/$sha.tar.gz"
    return 0
  fi

  readonly ARCHIVE="$INCOMING/$sha.tar.gz"
  [[ -f "$ARCHIVE" && ! -L "$ARCHIVE" && -s "$ARCHIVE" ]] || die "release archive is missing or invalid: $ARCHIVE"
  [[ "$(stat -c '%U' "$ARCHIVE")" == "$DEPLOY_USER" ]] || die "release archive owner does not match the incoming directory owner"

  install -d -o root -g "$APP_GROUP" -m 0750 "$RELEASES"
  if [[ -d "$RELEASE" ]]; then
    [[ -f "$RELEASE/server.js" && -f "$RELEASE/.next/BUILD_ID" && -d "$RELEASE/.next/static" ]] || die "an existing release directory is incomplete"
  else
    rm -rf "$STAGING"
    install -d -o root -g "$APP_GROUP" -m 0750 "$STAGING"
    python3 - "$ARCHIVE" <<'PY'
import posixpath
import sys
import tarfile
from pathlib import PurePosixPath

archive = sys.argv[1]
with tarfile.open(archive, "r:gz") as bundle:
    members = bundle.getmembers()
    if not members or len(members) > 100000:
        raise SystemExit("archive has an invalid number of entries")
    expanded_size = 0
    for member in members:
        path = PurePosixPath(member.name)
        if path.is_absolute() or ".." in path.parts:
            raise SystemExit(f"unsafe archive path: {member.name!r}")
        expanded_size += max(member.size, 0)
        if expanded_size > 2_000_000_000:
            raise SystemExit("archive expands beyond the 2 GB safety limit")
        if member.isdir() or member.isfile():
            continue
        if member.issym():
            if member.linkname.startswith("/"):
                raise SystemExit(f"absolute symlink rejected: {member.name!r}")
            resolved = posixpath.normpath(posixpath.join(posixpath.dirname(member.name), member.linkname))
            if resolved == ".." or resolved.startswith("../"):
                raise SystemExit(f"symlink escapes release directory: {member.name!r}")
            continue
        raise SystemExit(f"unsupported archive entry type: {member.name!r}")
PY
    tar --no-same-owner --no-same-permissions -xzf "$ARCHIVE" -C "$STAGING"
    [[ -f "$STAGING/server.js" ]] || die "standalone Next.js server.js is missing from the release"
    [[ -f "$STAGING/.next/BUILD_ID" ]] || die "Next.js BUILD_ID is missing from the release"
    [[ -d "$STAGING/.next/static" ]] || die "Next.js static assets are missing from the release"
    chown -R root:"$APP_GROUP" "$STAGING"
    chmod -R u+rwX,g+rX,o-rwx "$STAGING"
    install -d -o "$APP_USER" -g "$APP_GROUP" -m 0770 "$STAGING/.next/cache"
    mv "$STAGING" "$RELEASE"
    RELEASE_CREATED=1
  fi

  if [[ "$active_port" == "3000" ]]; then candidate_port="3001"; else candidate_port="3000"; fi
  CANDIDATE_PORT="$candidate_port"

  if [[ "$candidate_port" == "3000" ]] && systemctl is-active --quiet "$MAIN_SERVICE"; then
    systemctl stop "$MAIN_SERVICE"
    systemctl disable "$MAIN_SERVICE" >/dev/null 2>&1 || true
  fi
  systemctl stop "$(slot_service "$candidate_port")" >/dev/null 2>&1 || true
  systemctl disable "$(slot_service "$candidate_port")" >/dev/null 2>&1 || true
  atomic_set_slot "$candidate_port" "$RELEASE"
  systemctl start "$(slot_service "$candidate_port")"
  wait_for_port_health "$candidate_port" || die "candidate release failed the local /start health check on port $candidate_port"

  write_pending "$sha" "$candidate_port" "$active_port" "$old_release" "$had_active" \
    "$old_previous_release" "$old_previous_port" "$RELEASE_CREATED"
  switch_upstream_port "$candidate_port" || die "Nginx did not pass the health check after switching to the candidate"
  log "candidate $sha is serving through Nginx on port $candidate_port; waiting for the public health check"
  PREPARING=0
  trap - EXIT
}

commit_deploy() {
  local sha="$1" current_release
  if ! pending_load; then
    if [[ -L "$CURRENT" && "$(readlink -f "$CURRENT")" == "$RELEASES/$sha" ]]; then
      log "commit $sha is already finalized"
      return 0
    fi
    die "there is no valid pending deployment to commit"
  fi
  [[ "$P_SHA" == "$sha" ]] || die "pending commit SHA does not match $sha"
  systemctl is-active --quiet "$(slot_service "$P_NEW_PORT")" || die "candidate service is not active"
  wait_for_port_health "$P_NEW_PORT" || die "candidate service failed its health check before commit"
  [[ "$(read_upstream_port)" == "$P_NEW_PORT" ]] || die "Nginx is not routed to the candidate port"
  site_health_check || die "Nginx virtual-host health check failed before commit"
  [[ -d "$RELEASES/$P_SHA" ]] || die "candidate release directory is missing"
  current_release="$(readlink -f "$CURRENT")"
  [[ "$current_release" == "$P_OLD_RELEASE" ]] || die "current release changed while this deployment was pending"

  write_root_file "$PREVIOUS_RELEASE_FILE" "$P_OLD_RELEASE"
  write_root_file "$PREVIOUS_PORT_FILE" "$P_OLD_PORT"
  write_root_file "$ACTIVE_PORT_FILE" "$P_NEW_PORT"
  atomic_set_current "$RELEASES/$P_SHA"
  systemctl enable "$(slot_service "$P_NEW_PORT")" >/dev/null
  systemctl disable "$(slot_service "$P_OLD_PORT")" >/dev/null 2>&1 || true
  systemctl disable "$MAIN_SERVICE" >/dev/null 2>&1 || true
  rm -f "$PENDING_FILE" "$INCOMING/$P_SHA.tar.gz"
  log "committed release $P_SHA on port $P_NEW_PORT"
  log "previous release retained at $P_OLD_RELEASE on port $P_OLD_PORT"
}

rollback_committed() {
  local current_port previous_port current_release previous_release slot_target
  [[ -f "$ACTIVE_PORT_FILE" && -f "$PREVIOUS_PORT_FILE" && -f "$PREVIOUS_RELEASE_FILE" ]] || die "there is no committed previous release to roll back to"
  current_port="$(cat "$ACTIVE_PORT_FILE")"
  previous_port="$(cat "$PREVIOUS_PORT_FILE")"
  current_release="$(readlink -f "$CURRENT")"
  previous_release="$(cat "$PREVIOUS_RELEASE_FILE")"
  port_is_valid "$current_port" && port_is_valid "$previous_port" || die "rollback port state is invalid"
  [[ "$current_port" != "$previous_port" ]] || die "rollback port is the same as the active port"
  release_path_is_valid "$current_release" && release_path_is_valid "$previous_release" || die "rollback release path is invalid"
  [[ -d "$previous_release" ]] || die "previous release directory is missing"

  if [[ "$previous_port" == "3000" ]] && systemctl is-active --quiet "$MAIN_SERVICE"; then
    systemctl stop "$MAIN_SERVICE"
    systemctl disable "$MAIN_SERVICE" >/dev/null 2>&1 || true
  fi

  slot_target="$(readlink -f "$SLOTS/$previous_port" 2>/dev/null || true)"
  if ! systemctl is-active --quiet "$(slot_service "$previous_port")" || [[ "$slot_target" != "$previous_release" ]]; then
    systemctl stop "$(slot_service "$previous_port")" >/dev/null 2>&1 || true
    systemctl disable "$(slot_service "$previous_port")" >/dev/null 2>&1 || true
    atomic_set_slot "$previous_port" "$previous_release"
    systemctl start "$(slot_service "$previous_port")"
  fi
  wait_for_port_health "$previous_port" || die "previous release did not become healthy on port $previous_port"

  switch_upstream_port "$previous_port" || die "Nginx could not switch back to the previous release"
  write_root_file "$PREVIOUS_RELEASE_FILE" "$current_release"
  write_root_file "$PREVIOUS_PORT_FILE" "$current_port"
  write_root_file "$ACTIVE_PORT_FILE" "$previous_port"
  atomic_set_current "$previous_release"
  systemctl enable "$(slot_service "$previous_port")" >/dev/null
  systemctl disable "$(slot_service "$current_port")" >/dev/null 2>&1 || true
  log "rolled back to $previous_release on port $previous_port"
}

if [[ "$#" -gt 0 ]]; then ACTION="$1"; else ACTION=""; fi

if [[ "$ACTION" == "--check" ]]; then
  runuser -u "$DEPLOY_USER" -- test -w "$INCOMING" || die "incoming directory is not writable by the deploy account"
  [[ ! -e "$PENDING_FILE" ]] || die "a deployment is pending commit or rollback"
  nginx -t >/dev/null || die "Nginx configuration check failed"
  systemctl is-active --quiet nginx || die "Nginx service is not active"
  if [[ -f "$ACTIVE_PORT_FILE" ]]; then CURRENT_PORT="$(cat "$ACTIVE_PORT_FILE")"; else CURRENT_PORT="3000"; fi
  port_is_valid "$CURRENT_PORT" || die "active port state is invalid"
  [[ "$(read_upstream_port)" == "$CURRENT_PORT" ]] || die "Nginx upstream does not match the active application port"
  wait_for_current_service "$CURRENT_PORT" || die "active application health check failed"
  site_health_check || die "local Nginx /start health check failed"
  log "ready: current app, Nginx upstream, blue-green unit, incoming directory and local /start health checks are OK"
  exit 0
fi

exec 9>/run/lock/memphis-lspd-deploy.lock
flock -n 9 || die "another deployment or rollback is already running"

case "$ACTION" in
  --rollback)
    if [[ -f "$PENDING_FILE" ]]; then rollback_pending_internal; else rollback_committed; fi
    ;;
  --commit)
    [[ "$#" -eq 2 ]] || die "usage: memphis-deploy --commit <40-character-main-commit-sha>"
    [[ "$2" =~ ^[0-9a-f]{40}$ ]] || die "invalid commit SHA"
    commit_deploy "$2"
    ;;
  "")
    [[ "$#" -eq 1 ]] || die "usage: memphis-deploy <40-character-main-commit-sha>"
    prepare_deploy "$1"
    ;;
  *)
    die "usage: memphis-deploy <sha> | --check | --commit <sha> | --rollback"
    ;;
esac
