# Las Vegas application environment.
# Keep NEXT_PUBLIC_SITE_URL as the origin only; do not append /las-vegas.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Discord OAuth application dedicated to Las Vegas.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-domain.example/las-vegas/api/auth

# Generate a unique, high-entropy secret for this application.
JWT_SECRET=

# Dedicated Redis instance/database for Las Vegas only.
REDIS_URL=

# Discord webhook URLs. Configure only channels that are actually used.
WEBHOOK_SECURITY=
WEBHOOK_RECOVERY=
WEBHOOK_HIGH_RANK_REPORT=
WEBHOOK_PROMOTION=
WEBHOOK_RESIGNATION=
WEBHOOK_REINSTATEMENT=
WEBHOOK_TRANSFER_TO_LSPD=
WEBHOOK_HIRING=
WEBHOOK_WEAPON_REQUEST=
WEBHOOK_LEAVE=
WEBHOOK_PREMIUM=
WEBHOOK_COMPLAINT_PUBLIC=
WEBHOOK_COMPLAINT_PRIVATE=
WEBHOOK_AUDIT_URL=

# Department-specific webhooks are read dynamically by lib/departments.js:
# WEBHOOK_REPORT_AF=
# WEBHOOK_TRANSFER_AF=
# Repeat for each department key in lib/departments.js:
# IAD, SWAT, PAI, PA, ALPHA, DVD, DB, K9, CPD, HALT, TED, SRT, NRED, MED.
